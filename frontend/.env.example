# Optional full override (highest priority), e.g.:
# VITE_SESSIONS_ENDPOINT=http://localhost:8000/sessions
# VITE_SESSIONS_ENDPOINT=

# Optional base URL used to build `${VITE_API_BASE_URL}/sessions`, e.g.:
# VITE_API_BASE_URL=http://localhost:8000
# VITE_API_BASE_URL=

# Optional tile provider override for the session map, e.g.:
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_URL=
#
# Optional HTML attribution string shown on the map:
# VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# VITE_MAP_TILE_ATTRIBUTION=
