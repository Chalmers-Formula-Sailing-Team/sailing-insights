# PROD / DEFAULT
COMPOSE_PROJECT_NAME=sailing_insights

# Database credentials
POSTGRES_USER=sailing_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sailing
POSTGRES_CONTAINER_NAME=sailing_app_db

# Network
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1


# DB Path
POSTGRES_DATA_PATH=./data

# Optional Docker ports
BACKEND_PUBLIC_PORT=8000
FRONTEND_PORT=8080
APP_VERSION=latest
BACKEND_IMAGE_NAME=sailing-insights-backend
FRONTEND_IMAGE_NAME=sailing-insights-frontend
